{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "agent",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "deny"
    }
  },
  "agent": {
    "agent": {
      "description": "GAS Default Agent",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "allow",
        "edit": "ask",
        "bash": "ask",
        "skill": {
          "*": "deny"
        }
      }
    },
    "plan": {
      "description": "GAS Planning Agent",
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  }
}